{
  "name": "obsidian-for-dsh",
  "version": "1.2.3",
  "description": "Obsidian CLI as native DSH tools, plus the official Obsidian agent skills.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "icon": "./icon.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "assets",
    "skills",
    "scripts",
    "locale/*.json",
    "icon.png",
    "upstream.json",
    "README*.md",
    "CONTRIBUTORS.md",
    "LICENSE",
    "LICENSE.upstream",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs test/sync-upstream.test.mjs test/update.test.mjs test/tools.test.mjs",
    "check": "node --check index.js && npm test",
    "sync:upstream": "node scripts/sync-upstream.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangJingJun-dev/obsidian-for-dsh.git"
  },
  "homepage": "https://github.com/WangJingJun-dev/obsidian-for-dsh#readme",
  "bugs": {
    "url": "https://github.com/WangJingJun-dev/obsidian-for-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "obsidian",
    "obsidian-cli",
    "agent-skills",
    "markdown",
    "bases",
    "canvas",
    "tasknotes",
    "hearth"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "packageManager": "pnpm@11.28.5"
}
